[user]
        email = hugo.pompougnac@inria.fr
        name = Hugo Pompougnac
[i18n]
        logOutputEncoding = utf-8
        commitEncoding = utf-8
[core]
        pager = less -R
[diff]
        algorithm = histogram
        wordRegex = [^[:space:]]+
[log]
        date = short
        abbrevCommit = true
[pull]
        rebase = true
[rebase]
        autoStash = true
[push]
        default = simple
        autoSetupRemote = true
[fetch]
        prune = true
[advice]
        statusHints = false
        addIgnoredFile = false
[alias]
        lg = log --oneline --graph --decorate
        lga = log --oneline --graph --decorate --all
        last = log -1 HEAD --stat
        amend = commit --amend --no-edit
        pf = push --force
        rewind = "!f() { \
          GIT_SEQUENCE_EDITOR=\"sed -i '1s/^pick/edit/'\" git rebase -i HEAD~${1:-2}; \
        }; f"
[help]
        autocorrect = 1
